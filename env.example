# Copy this file to ".env" and fill in your key. Never commit ".env".
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Port the server listens on (hosting platforms usually set this for you)
PORT=3000

# Only needed when the website is hosted somewhere else (for example GitHub Pages).
# Comma-separated list of allowed website addresses, no trailing slash.
# Example: https://your-username.github.io
CORS_ORIGIN=

# Set to 1 when the server runs behind a hosting proxy (Render, Railway, Fly...) so rate limits use the real visitor IP
TRUST_PROXY=0

# AI requests allowed per visitor per minute
RATE_LIMIT_PER_MIN=30
